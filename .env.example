# Copy this file to .env and fill in values from `npx supabase status` after `npx supabase start`.
# Security rule: Only the public anon key belongs here. Never place service_role in browser environment files.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_MAX_UPLOAD_MB=50

